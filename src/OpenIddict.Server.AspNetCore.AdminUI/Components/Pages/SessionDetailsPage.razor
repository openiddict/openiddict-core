@* Displays a session (the attached principal is never rendered), the tokens attached to it and, after a termination, its result. *@
@using Microsoft.AspNetCore.WebUtilities
@using OpenIddict.Server
@using static OpenIddict.Server.AspNetCore.AdminUI.OpenIddictServerAspNetCoreAdminUIFormatting

<AdminLayout BasePath="@BasePath" Title="@("Session " + Id)" Section="@Paths.Sessions" Notice="@Notice" Errors="@Errors">
    @if (Result is not null)
    {
        <section class="oi-secret" aria-labelledby="termination-result">
            <h2 id="termination-result">Termination result</h2>

            @if (Result.SessionIds.IsDefaultOrEmpty)
            {
                <p class="oi-muted">No valid session was terminated: the session was already terminated.</p>
            }
            else
            {
                <dl class="oi-details">
                    <dt>Terminated sessions</dt>
                    <dd>
                        @foreach (var session in Result.SessionIds)
                        {
                            <a href="@(Url + "/" + Uri.EscapeDataString(session))"><code>@session</code></a>
                            @(" ")
                        }
                    </dd>
                    <dt>Notified clients</dt>
                    <dd>@FormatList(Result.NotifiedParticipants.Select(static participant => participant.ClientId))</dd>
                    <dt>Failed notifications</dt>
                    <dd>@FormatList(Result.FailedParticipants.Select(static participant => participant.ClientId))</dd>
                </dl>

                @if (!Result.FailedParticipants.IsDefaultOrEmpty)
                {
                    <p class="oi-errors" role="alert">
                        The back-channel logout notification couldn't be delivered to some client applications:
                        the users of these applications may still be logged in until their local session expires.
                    </p>
                }

                @if (!Result.FrontchannelLogoutUris.IsDefaultOrEmpty)
                {
                    <h3>Front-channel logout URIs</h3>
                    @* Note: front-channel logout URIs must be loaded by the end user's user agent (OpenID Connect
                       Front-Channel Logout 1.0, section 3): they are displayed but never loaded by the admin UI. *@
                    <p class="oi-muted">
                        These URIs can only be used by the end user's browser and are not loaded by the admin UI.
                    </p>
                    <ul>
                        @foreach (var uri in Result.FrontchannelLogoutUris)
                        {
                            <li><code>@uri.AbsoluteUri</code></li>
                        }
                    </ul>
                }
            }
        </section>
    }

    <dl class="oi-details">
        <dt>Identifier</dt><dd><code>@Id</code></dd>
        <dt>Subject</dt><dd>@FormatValue(Descriptor.Subject)</dd>
        <dt>Client</dt><dd>@FormatClient(ClientIds, Descriptor.ApplicationId)</dd>
        <dt>Login ID</dt>
        <dd>
            @if (string.IsNullOrEmpty(Descriptor.LoginId))
            {
                @FormatValue(null)
            }
            else
            {
                <a href="@QueryHelpers.AddQueryString(Url, QueryStringParameters.LoginId, Descriptor.LoginId)"><code>@Descriptor.LoginId</code></a>
            }
        </dd>
        <dt>Authorization</dt>
        <dd>
            @if (string.IsNullOrEmpty(Descriptor.AuthorizationId))
            {
                @FormatValue(null)
            }
            else
            {
                <a href="@(BasePath + "/" + Paths.Authorizations + "/" + Uri.EscapeDataString(Descriptor.AuthorizationId))"><code>@Descriptor.AuthorizationId</code></a>
            }
        </dd>
        <dt>Status</dt><dd>@FormatValue(Descriptor.Status)</dd>
        <dt>Created</dt><dd>@FormatDate(Descriptor.CreationDate)</dd>
        <dt>Last activity</dt><dd>@FormatDate(Descriptor.LastActivityDate)</dd>
        <dt>Expires</dt><dd>@FormatDate(Descriptor.ExpirationDate)</dd>
    </dl>

    @if (Descriptor.Status == Statuses.Valid)
    {
        <form method="post" action="@(ItemUrl + "/" + Paths.Terminate)">
            <AntiforgeryToken />
            <p class="oi-muted">
                Terminating the session revokes it, alongside the valid sessions sharing its login identifier,
                and notifies the client applications that participated in these sessions, if logout notifications are enabled.
            </p>
            <p><button type="submit" class="oi-danger">Terminate this session</button></p>
        </form>
    }

    <h2>Tokens</h2>
    @if (Tokens.Count is 0)
    {
        <p class="oi-muted">No token is attached to this session.</p>
    }
    else
    {
        <div class="oi-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Identifier</th>
                        <th scope="col">Type</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col">Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (id, token) in Tokens)
                    {
                        <tr>
                            <td><a href="@(BasePath + "/" + Paths.Tokens + "/" + Uri.EscapeDataString(id))"><code>@id</code></a></td>
                            <td>@FormatValue(token.Type)</td>
                            <td>@FormatValue(token.Status)</td>
                            <td>@FormatDate(token.CreationDate)</td>
                            <td>@FormatDate(token.ExpirationDate)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (HasMoreTokens)
    {
        <p class="oi-muted" role="note">
            More tokens are attached to this session: only the first @Tokens.Count tokens are displayed.
        </p>
    }

    <p><a href="@Url">Back to the sessions</a></p>
</AdminLayout>

@code {
    /// <summary>Gets or sets the base path of the admin UI.</summary>
    [Parameter, EditorRequired] public string BasePath { get; set; } = default!;

    /// <summary>Gets or sets the identifier of the session.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    /// <summary>Gets or sets the session descriptor (without principal).</summary>
    [Parameter, EditorRequired] public OpenIddictSessionDescriptor Descriptor { get; set; } = default!;

    /// <summary>Gets or sets the tokens attached to the session (without payload).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Id, OpenIddictTokenDescriptor Descriptor)> Tokens { get; set; } = default!;

    /// <summary>Gets or sets a value indicating whether more tokens than the displayed ones are attached to the session.</summary>
    [Parameter] public bool HasMoreTokens { get; set; }

    /// <summary>Gets or sets the client identifiers, indexed by application identifier.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string> ClientIds { get; set; } = default!;

    /// <summary>Gets or sets the result of the session termination, if the session was just terminated.</summary>
    [Parameter] public OpenIddictServerSessionTerminationResult? Result { get; set; }

    /// <summary>Gets or sets the errors to display.</summary>
    [Parameter] public IReadOnlyList<string>? Errors { get; set; }

    /// <summary>Gets or sets the notice code to display, if any.</summary>
    [Parameter] public string? Notice { get; set; }

    private string Url => BasePath + "/" + Paths.Sessions;

    private string ItemUrl => Url + "/" + Uri.EscapeDataString(Id);

    private static string FormatList(IEnumerable<string> values)
        => string.Join(", ", values.Distinct(StringComparer.Ordinal)) is { Length: > 0 } value ? value : Empty;
}
