@* Lists the tokens (payloads are never rendered), optionally filtered by subject, client, status and type. *@
@using static OpenIddict.Server.AspNetCore.AdminUI.OpenIddictServerAspNetCoreAdminUIFormatting

<AdminLayout BasePath="@BasePath" Title="Tokens" Section="@Paths.Tokens" Notice="@Notice">
    <form class="oi-toolbar" method="get" action="@Url" role="search">
        <div>
            <label for="subject">Subject</label>
            <input id="subject" type="search" name="@QueryStringParameters.Subject" value="@Subject" />
        </div>
        <div>
            <label for="client">Client ID</label>
            <input id="client" type="search" name="@QueryStringParameters.Client" value="@Client" />
        </div>
        <div>
            <label for="status">Status</label>
            <select id="status" name="@QueryStringParameters.Status">
                <option value="" selected="@(Status is null)">(any)</option>
                @foreach (var value in OpenIddictServerAspNetCoreAdminUIForms.KnownStatuses)
                {
                    <option value="@value" selected="@(Status == value)">@value</option>
                }
            </select>
        </div>
        <div>
            <label for="type">Type</label>
            <input id="type" type="search" name="@QueryStringParameters.Type" value="@Type" />
        </div>
        <button type="submit" class="oi-secondary">Filter</button>
    </form>

    @if (Items.Count is 0)
    {
        <p class="oi-muted">No token was found.</p>
    }
    else
    {
        <div class="oi-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Identifier</th>
                        <th scope="col">Type</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Client</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col">Expires</th>
                        <th scope="col"><span class="oi-muted">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (id, descriptor) in Items)
                    {
                        <tr>
                            <td><a href="@(Url + "/" + Uri.EscapeDataString(id))"><code>@id</code></a></td>
                            <td>@FormatValue(descriptor.Type)</td>
                            <td>@FormatValue(descriptor.Subject)</td>
                            <td>@FormatClient(ClientIds, descriptor.ApplicationId)</td>
                            <td>@FormatValue(descriptor.Status)</td>
                            <td>@FormatDate(descriptor.CreationDate)</td>
                            <td>@FormatDate(descriptor.ExpirationDate)</td>
                            <td>
                                @if (descriptor.Status != Statuses.Revoked)
                                {
                                    <form class="oi-inline" method="post" action="@(Url + "/" + Uri.EscapeDataString(id) + "/" + Paths.Revoke)">
                                        <AntiforgeryToken />
                                        <button type="submit" class="oi-danger">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <Pager Url="@Url" PageNumber="@PageNumber" HasNextPage="@HasNextPage" Filters="@(new Dictionary<string, string?>
    {
        [QueryStringParameters.Subject] = Subject,
        [QueryStringParameters.Client] = Client,
        [QueryStringParameters.Status] = Status,
        [QueryStringParameters.Type] = Type
    })" />
</AdminLayout>

@code {
    /// <summary>Gets or sets the base path of the admin UI.</summary>
    [Parameter, EditorRequired] public string BasePath { get; set; } = default!;

    /// <summary>Gets or sets the tokens (identifier and descriptor, without payload).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Id, OpenIddictTokenDescriptor Descriptor)> Items { get; set; } = default!;

    /// <summary>Gets or sets the client identifiers, indexed by application identifier.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string> ClientIds { get; set; } = default!;

    /// <summary>Gets or sets the subject filter, if any.</summary>
    [Parameter] public string? Subject { get; set; }

    /// <summary>Gets or sets the client filter, if any.</summary>
    [Parameter] public string? Client { get; set; }

    /// <summary>Gets or sets the status filter, if any.</summary>
    [Parameter] public string? Status { get; set; }

    /// <summary>Gets or sets the type filter, if any.</summary>
    [Parameter] public string? Type { get; set; }

    /// <summary>Gets or sets the current page number.</summary>
    [Parameter] public int PageNumber { get; set; } = 1;

    /// <summary>Gets or sets a value indicating whether a next page exists.</summary>
    [Parameter] public bool HasNextPage { get; set; }

    /// <summary>Gets or sets the notice code to display, if any.</summary>
    [Parameter] public string? Notice { get; set; }

    private string Url => BasePath + "/" + Paths.Tokens;
}
