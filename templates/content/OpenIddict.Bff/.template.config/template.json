{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenIddict",
  "classifications": [ "Web", "OpenIddict", "OAuth", "OpenID Connect", "BFF" ],
  "identity": "OpenIddict.Templates.Bff",
  "groupIdentity": "OpenIddict.Templates.Bff",
  "name": "OpenIddict backend-for-frontend (BFF)",
  "description": "Backend-for-frontend host using the OpenIddict client, OpenIddict.Client.AspNetCore.Bff (session endpoints, token refresh, antiforgery) and YARP to proxy API calls.",
  "shortName": "openiddict-bff",
  "sourceName": "Company.Bff",
  "preferNameDirectory": true,
  "defaultName": "Bff",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "OpenIddictVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "The version of the OpenIddict packages referenced by the project.",
      "defaultValue": "8.0.0-preview.5",
      "replaces": "OPENIDDICT_VERSION"
    },
    "Authority": {
      "type": "parameter",
      "datatype": "text",
      "description": "The URI of the OpenID Connect server.",
      "defaultValue": "https://localhost:44310/",
      "replaces": "https://localhost:44310/"
    },
    "ClientId": {
      "type": "parameter",
      "datatype": "text",
      "description": "The client identifier registered in the OpenID Connect server.",
      "defaultValue": "bff",
      "replaces": "CLIENT_ID"
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 44300, "high": 44399 },
      "replaces": "44312"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 },
      "replaces": "5012"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "exclude": [ "bin/**", "obj/**", "**/*.user" ] }
      ]
    }
  ],
  "primaryOutputs": [ { "path": "Company.Bff.csproj" } ]
}
