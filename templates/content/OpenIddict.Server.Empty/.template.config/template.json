{
  "$schema": "http://json.schemastore.org/template",
  "author": "OpenIddict",
  "classifications": [ "Web", "OpenIddict", "OAuth", "OpenID Connect" ],
  "identity": "OpenIddict.Templates.Server.Empty",
  "groupIdentity": "OpenIddict.Templates.Server.Empty",
  "name": "OpenIddict authorization server (empty)",
  "description": "Minimal OpenID Connect server using minimal APIs, Entity Framework Core (SQLite) and pass-through authorization, token, end session and userinfo endpoints.",
  "shortName": "openiddict-server-empty",
  "sourceName": "Company.Server",
  "preferNameDirectory": true,
  "defaultName": "AuthorizationServer",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "OpenIddictVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "The version of the OpenIddict packages referenced by the project.",
      "defaultValue": "8.0.0-preview.5",
      "replaces": "OPENIDDICT_VERSION"
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 44300, "high": 44399 },
      "replaces": "44311"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 5000, "high": 5300 },
      "replaces": "5011"
    }
  },
  "sources": [
    {
      "modifiers": [
        { "exclude": [ "bin/**", "obj/**", "**/*.user", "**/*.sqlite3*" ] }
      ]
    }
  ],
  "primaryOutputs": [ { "path": "Company.Server.csproj" } ]
}
